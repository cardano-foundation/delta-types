cabal-version:      3.6
build-type:         Simple
name:               sqlite-table
version:            0.1.0.0
synopsis:           Type-level SQL tables
description:
  This package provides combinators for

    * Defining SQL tables at the type level.

    * Running "update" and "query" statements using these types.

  Compatible with
  [sqlite-simple](https://hackage.haskell.org/package/sqlite-simple).

homepage:           https://github.com/cardano-foundation/delta-types
license:            Apache-2.0
author:             Cardano Foundation (High Assurance Lab)
maintainer:         hal@cardanofoundation.org
copyright:          2023-2024 Cardano Foundation
category:           Database
extra-source-files: README.md

common language
  default-language:   Haskell2010
  default-extensions:
    NoImplicitPrelude
    OverloadedStrings

common opts-lib
  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wincomplete-uni-patterns
    -Wincomplete-record-updates

  if flag(release)
    ghc-options: -O2 -Werror

common opts-exe
  import:      opts-lib
  ghc-options: -threaded -rtsopts

flag release
  description: Enable optimization and `-Werror`
  default:     False
  manual:      True

library
  import:          language, opts-lib
  hs-source-dirs:  src
  build-depends:
    , base           >=4.14     && <5
    , bytestring     >=0.10.6   && <0.13
    , containers     >=0.5      && <0.8
    , io-classes     >=1.4.0.0  && <1.8
    , Only           >=0.1      && <0.2
    , sqlite-simple  >=0.4.18.0 && <0.5
    , text           >=1.2      && <2.2
    , transformers   >=0.6.1.0  && <0.7

  hs-source-dirs:  src
  exposed-modules:
    Database.Table.Schema
    Database.Table.SQLite.Simple

  other-modules:
    Database.Table.SQL.Column
    Database.Table.SQL.Expr
    Database.Table.SQL.Stmt
    Database.Table.SQL.Table
    Database.Table.SQL.Var
    Database.Table.SQLite.Simple.Exec
    Database.Table.SQLite.Simple.Monad

test-suite unit
  import:             language, opts-exe
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test/unit
  main-is:            Main.hs
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    , base
    , hspec         >=2.11.0 && <2.12
    , sqlite-table
    , text

  other-modules:
    Database.Table.SchemaSpec
    Database.Table.SQLite.SimpleSpec
